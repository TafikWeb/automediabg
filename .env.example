# Копирай този файл на .env и попълни истинските стойности. Никога не качвай .env в git!

SECRET_KEY=generate-a-long-random-string-here

# Вход в /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# За локално тестване (http://localhost) остави "development" — иначе session
# бисквитката изисква HTTPS и няма да работиш локално. На Railway/production
# просто изтрий този ред или го смени на каквото и да е различно от "development".
FLASK_ENV=development

# Telegram бот за известия (виж README.md стъпка "Telegram бот")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Community бот с реферална програма за отстъпки (виж README.md стъпка
# "Telegram общност и отстъпки") — отделен бот от този по-горе.
TELEGRAM_COMMUNITY_BOT_TOKEN=
TELEGRAM_GROUP_ID=

# Адресът на живия сайт (без наклонена черта накрая) — ползва се от бота, за
# да дава линк към продуктите. Напр. https://automediabg.up.railway.app
SITE_URL=

# Резервен контакт, който ботът дава на клиент, ако не отговориш до 2 часа.
OWNER_TELEGRAM_USERNAME=TafikM
OWNER_PHONE=0897485885

# Revolut таг/телефон, на който партньорите изпращат 1 EUR за верификация
# при заявка за изплащане по банков път.
REVOLUT_VERIFY_ACCOUNT=@automediabg

# Google Analytics (по избор) — Measurement ID във формат G-XXXXXXXXXX.
# Оставѝ празно, ако още нямаш GA профил — сайтът работи нормално и без него.
GOOGLE_ANALYTICS_ID=

# Папка за база данни + качени снимки. ЗАДЪЛЖИТЕЛНО на Railway да сочи
# към mount path-а на Volume-а (виж README.md стъпка "Деплой в Railway"),
# иначе продуктите/снимките/заявките ще се трият при всеки нов deploy.
DATA_DIR=/app/data
